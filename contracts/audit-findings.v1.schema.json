{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/whystrohm/shotkit/blob/main/contracts/audit-findings.v1.schema.json",
  "title": "WhyStrohm audit findings, v1",
  "description": "The result of one content audit. Written by whystrohm-audit to brand/audit-findings.json. Read by storyboard-architect as an optional brief input: the top gap can set the pain beat, and the rewrite can supply an overlay line. The canonical copy lives in github.com/whystrohm/shotkit under contracts/. Other repos keep a byte-identical copy, and CI checks it.",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "version", "url", "audited_at", "method", "sample", "layers", "total", "top_gaps", "rewrite"],
  "properties": {
    "contract": { "const": "audit-findings" },
    "version": { "const": "1" },
    "url": { "type": "string", "pattern": "^https?://", "description": "The site the audit read for context." },
    "audited_at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}" },
    "method": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "weights"],
      "properties": {
        "name": { "const": "whystrohm-audit" },
        "weights": {
          "type": "object",
          "description": "Share of the total each layer carries. They sum to 1.",
          "additionalProperties": false,
          "required": ["vocabulary", "structure", "proof", "voice_consistency", "buyer_alignment"],
          "properties": {
            "vocabulary": { "type": "number", "minimum": 0, "maximum": 1 },
            "structure": { "type": "number", "minimum": 0, "maximum": 1 },
            "proof": { "type": "number", "minimum": 0, "maximum": 1 },
            "voice_consistency": { "type": "number", "minimum": 0, "maximum": 1 },
            "buyer_alignment": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        }
      }
    },
    "sample": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "text"],
      "properties": {
        "source": { "enum": ["pasted", "fetched"] },
        "text": { "type": "string", "minLength": 1, "description": "The content that was scored, exactly as given." }
      }
    },
    "layers": {
      "type": "object",
      "additionalProperties": false,
      "required": ["vocabulary", "structure", "proof", "voice_consistency", "buyer_alignment"],
      "properties": {
        "vocabulary": { "$ref": "#/$defs/layer" },
        "structure": { "$ref": "#/$defs/layer" },
        "proof": { "$ref": "#/$defs/layer" },
        "voice_consistency": { "$ref": "#/$defs/layer" },
        "buyer_alignment": { "$ref": "#/$defs/layer" }
      }
    },
    "total": {
      "type": "object",
      "additionalProperties": false,
      "required": ["score"],
      "properties": {
        "score": { "type": "integer", "minimum": 0, "maximum": 100, "description": "Sum of each layer score times 10 times its weight, rounded." }
      }
    },
    "top_gaps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["layer", "gap", "fix"],
        "properties": {
          "layer": { "enum": ["vocabulary", "structure", "proof", "voice_consistency", "buyer_alignment"] },
          "gap": { "type": "string", "minLength": 1 },
          "fix": { "type": "string", "minLength": 1 }
        }
      }
    },
    "rewrite": {
      "type": "object",
      "additionalProperties": false,
      "required": ["before", "after"],
      "properties": {
        "before": { "type": "string", "minLength": 1 },
        "after": { "type": "string", "minLength": 1, "description": "Uses only facts the user supplied. Missing proof stays a bracketed placeholder." },
        "after_score": { "type": ["integer", "null"], "minimum": 0, "maximum": 100 }
      }
    }
  },
  "$defs": {
    "layer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["score", "evidence"],
      "properties": {
        "score": { "type": "integer", "minimum": 1, "maximum": 10 },
        "evidence": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["quote", "why"],
            "properties": {
              "quote": { "type": "string", "minLength": 1, "description": "Exact text from the sample." },
              "why": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    }
  }
}
